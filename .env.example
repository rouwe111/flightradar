# Copy to .env and fill in. Next.js loads it; real environment variables win.

# Centre of the radar: your house (decimal degrees). Required.
HOME_LATITUDE=46.233
HOME_LONGITUDE=6.056

# Time zone for the clock on the dashboard view. Default: the server's.
TIMEZONE=Europe/Zurich

# Search radius in nautical miles, 5 to 250. 15 is about 28 km.
RADIUS_NM=15

# Follow one flight wherever it is, instead of the sky above the house.
# A flight number (KL1001) or callsign (KLM1001). Leave empty for the sky.
FLIGHT_NUMBER=

# led (pixel display) or dashboard (light, with a radar and details).
VIEW=led
# LED view only: 0.2 to 1, for night time.
BRIGHTNESS=1
# LED view only: false turns off the glow on slow hardware.
BLOOM=true

# airline: only airline and military flights (default). all: every aircraft,
# including private planes, helicopters and gliders.
AIRCRAFT_FILTER=airline

# Seconds without a tap, mouse move or key before the cursor and the Reload
# button hide (1 to 60).
IDLE_SECONDS=3
# LED view only: frames per second of the moving parts (1 to 60). Lower it on
# weak hardware.
LED_FPS=15

# How often the screen asks for new positions, in seconds (5 to 300).
POLL_SECONDS=10

# The port is read by Next.js itself: PORT=3000 pnpm start

# Data sources and how this app introduces itself to them.
ADSB_API_URL=https://api.adsb.lol
ROUTES_API_URL=https://adsb.im/api/0/routeset
ADSBDB_API_URL=https://api.adsbdb.com
USER_AGENT=flightradar (personal flight display)

# Caching and rate limiting towards adsb.lol, all in seconds. The defaults suit
# adsb.lol's limit (about one request per 2 seconds per IP); lowering
# ADSB_MIN_GAP_SECONDS below 2.5 risks being blocked.
# How long an answer for the area stays fresh (1 to 300).
ADSB_CACHE_SECONDS=10
# Same for a followed flight far away (1 to 600).
FLIGHT_CACHE_SECONDS=20
# How long the last answer is kept for when adsb.lol pauses or fails (10 to 3600).
ADSB_STALE_SECONDS=300
# Minimum time between two requests to adsb.lol (0.5 to 60).
ADSB_MIN_GAP_SECONDS=2.5
# Pause after a rate limit answer that names no wait time (1 to 600).
ADSB_PAUSE_SECONDS=10
# How long a route (adsb.im) and a flight number lookup (adsbdb) are remembered.
ROUTE_CACHE_SECONDS=1800
CALLSIGN_CACHE_SECONDS=21600
